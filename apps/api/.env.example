PORT=4000
WEB_ORIGIN=https://shop.ecommerce.localhost:3443
ADMIN_ORIGIN=https://admin.ecommerce.localhost:3444
APP_WEB_URL=https://shop.ecommerce.localhost:3443
AUTH_ACCESS_COOKIE_NAME=ep_access_token
AUTH_REFRESH_COOKIE_NAME=ep_refresh_token
AUTH_CSRF_COOKIE_NAME=ep_csrf_token
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_COOKIE_DOMAIN=.ecommerce.localhost
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
MAIL_PROVIDER=console
MAIL_FROM="E-commerce <onboarding@resend.dev>"
RESEND_API_KEY=
